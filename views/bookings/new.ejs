<% layout("/layouts/boilerplate") %>

<div class="container-narrow" style="margin: 0 auto;">
    <div class="booking-card" style="position: static; max-width: 480px; margin: 0 auto;">
        <h2 class="booking-card-title">Book <%= listing.title %></h2>

        <form action="/listings/<%= listing._id %>/book" method="POST" class="booking-card-form">

            <div class="booking-card-field">
                <label for="checkIn" class="booking-card-field-label">Check-in</label>
                <input
                    type="date"
                    id="checkIn"
                    name="checkIn"
                    class="booking-card-field-input"
                    required
                >
            </div>

            <div class="booking-card-field">
                <label for="checkOut" class="booking-card-field-label">Check-out</label>
                <input
                    type="date"
                    id="checkOut"
                    name="checkOut"
                    class="booking-card-field-input"
                    required
                >
            </div>

            <div class="booking-card-field">
                <label for="guests" class="booking-card-field-label">Guests</label>
                <input
                    type="number"
                    id="guests"
                    name="guests"
                    min="1"
                    value="1"
                    class="booking-card-field-input"
                    required
                >
            </div>

            <button class="btn btn-primary btn-block mt-4">
                Continue to Payment
            </button>

        </form>
    </div>
</div>
