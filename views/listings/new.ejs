<% layout("/layouts/boilerplate") %>

<div class="form-container">
    <div class="form-section">
        <h1 class="form-section-title">Create a New Listing</h1>
        <p class="form-section-description">Share your space with travelers around the world.</p>

        <form action="/listings" method="POST" class="needs-validation" novalidate>

            <div class="form-group">
                <label for="title" class="form-label">Title</label>
                <input type="text" name="title" id="title" placeholder="Add a catchy title"
                    class="form-control" required>
                <div class="error-message">Please provide a title for your listing.</div>
            </div>

            <div class="form-group">
                <label for="description" class="form-label">Description</label>
                <textarea name="description" id="description" placeholder="Describe your listing"
                    class="form-control" required></textarea>
                <div class="error-message">Please provide a description for your listing.</div>
            </div>

            <div class="form-group">
                <label for="image" class="form-label">Image URL</label>
                <input type="text" name="image.url" id="image" placeholder="Image URL" class="form-control">
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="price" class="form-label">Price</label>
                    <input type="text" name="price" id="price" placeholder="1200"
                        class="form-control" required>
                    <div class="error-message">Please provide a price for your listing.</div>
                </div>

                <div class="form-group">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="country" id="country" placeholder="India"
                        class="form-control" required>
                    <div class="error-message">Please provide a country for your listing.</div>
                </div>
            </div>

            <div class="form-group">
                <label for="location" class="form-label">Location</label>
                <input type="text" name="location" id="location" placeholder="Mumbai, Maharashtra"
                    class="form-control" required>
                <div class="error-message">Please provide a location for your listing.</div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Add Listing</button>
            </div>

        </form>
    </div>
</div>
