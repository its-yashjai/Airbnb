<% layout("/layouts/boilerplate") %>

<% let avgRating = 0;
   if (listing.reviews.length > 0) {
     avgRating = (listing.reviews.reduce((sum, r) => sum + r.rating, 0) / listing.reviews.length).toFixed(1);
   }
%>

<div class="listing-details-header">
    <h1 class="listing-details-title"><%= listing.title %></h1>
    <p class="listing-details-location">
        <i class="fa-solid fa-location-dot"></i>
        <%= listing.location %>, <%= listing.country %>
    </p>

    <% if (listing.reviews.length > 0) { %>
    <div class="listing-details-rating">
        <span class="listing-details-rating-stars">
            <i class="fa-solid fa-star"></i> <%= avgRating %>
        </span>
        <span class="listing-details-rating-text">
            (<%= listing.reviews.length %> review<%= listing.reviews.length !== 1 ? 's' : '' %>)
        </span>
    </div>
    <% } %>
</div>

<img
    src="<%= listing.image.url || 'https://via.placeholder.com/1200x600' %>"
    alt="listing image"
    style="width: 100%; height: 420px; object-fit: cover; border-radius: var(--radius-xl); margin-bottom: var(--spacing-8);"
>

<div class="listing-details-content">
    <div class="listing-details-main">
        <p class="listing-details-description"><%= listing.description %></p>

        <hr class="listing-details-divider">

        <div class="reviews-section" style="margin-top: 0; padding-top: 0; border-top: none;">
            <h3 class="reviews-section-title">Reviews</h3>

            <% if (listing.reviews.length > 0) { %>

                <div class="reviews-summary">
                    <div class="reviews-summary-rating"><%= avgRating %></div>
                    <div class="reviews-summary-details">
                        <div class="reviews-summary-title">Guest ratings</div>
                        <div class="reviews-summary-count"><%= listing.reviews.length %> review<%= listing.reviews.length !== 1 ? 's' : '' %></div>
                    </div>
                </div>

                <div class="reviews-list mb-8">
                    <% listing.reviews.forEach(review => { %>
                        <div class="review-card">
                            <div class="review-card-header">
                                <div class="review-card-avatar">G</div>
                                <div class="review-card-info">
                                    <div class="review-card-name">Guest</div>
                                    <div class="review-card-date"><%= new Date(review.createdAt).toDateString() %></div>
                                </div>
                            </div>
                            <div class="review-card-rating stars">
                                <% for (let i = 0; i < review.rating; i++) { %><i class="fa-solid fa-star"></i><% } %>
                            </div>
                            <p class="review-card-text"><%= review.comment %></p>
                        </div>
                    <% }) %>
                </div>

            <% } else { %>

                <p class="text-secondary mb-8">No reviews yet.</p>

            <% } %>

            <div class="form-section" style="max-width: 100%; margin-bottom: 0;">
                <h4 class="mb-4">Leave a Review</h4>
                <form action="/listings/<%= listing._id %>/reviews" method="POST">
                    <div class="form-group">
                        <label for="rating" class="form-label">Rating</label>
                        <input type="range" id="rating" name="review[rating]" min="1" max="5" class="form-control">
                    </div>
                    <div class="form-group">
                        <label for="comment" class="form-label">Comment</label>
                        <textarea id="comment" name="review[comment]" rows="4" class="form-control"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Submit Review</button>
                </form>
            </div>
        </div>
    </div>

    <aside>
        <div class="booking-card">
            <h3 class="booking-card-title">Stay here</h3>
            <div class="booking-card-price">
                <span class="booking-card-price-amount">
                    <%= listing.price.toLocaleString('en-IN', { style: 'currency', currency: 'INR' }) %>
                </span>
                <span class="booking-card-price-period">/ night</span>
            </div>

            <div class="flex flex-col gap-3">
                <% if (currentUser) { %>
                    <a href="/listings/<%= listing._id %>/book" class="btn btn-success btn-block">Book Now</a>
                <% } else { %>
                    <a href="/auth/google" class="btn btn-primary btn-block">Login to Book</a>
                <% } %>

                <a href="/listings/<%= listing._id %>/edit" class="btn btn-secondary btn-block">Edit Listing</a>

                <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST" style="margin: 0;">
                    <button class="btn btn-danger btn-block">Delete Listing</button>
                </form>
            </div>
        </div>
    </aside>
</div>
